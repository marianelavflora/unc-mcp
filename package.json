{
  "name": "utn-mcp",
  "version": "0.8.1",
  "description": "Este es el Model Context Protocol server NO OFICIAL de la UTN para buscar informacion o archivos en el aula virtual.",
  "main": "build/index.js",
  "bin": {
    "utn-mcp": "build/index.js"
  },
  "files": [
    "build",
    "vendor"
  ],
  "scripts": {
    "prebuild": "node -e \"require('fs').rmSync('build',{recursive:true,force:true})\"",
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "prepare": "node scripts/vendor-pdfjs.mjs && npm run build",
    "start": "node build/index.js",
    "dev": "tsx src/index.ts",
    "test": "echo \"Error: no test specified\" && exit 1",
    "login": "tsx src/index.ts login"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nialvape/utn-mcp.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "utn",
    "aula-virtual"
  ],
  "author": "Joaquín Peñalva (https://github.com/nialvape)",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/nialvape/utn-mcp/issues"
  },
  "homepage": "https://utnmcp.com.ar",
  "dependencies": {
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/server": "^2.3.0",
    "@napi-rs/keyring": "^2.1.0",
    "express": "^5.2.1",
    "tough-cookie": "^6.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "pdfjs-dist": "^6.4.299",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20"
  }
}
