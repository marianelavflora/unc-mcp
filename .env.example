# Configuración del modo HTTP (`utn-mcp --http`). Copiá este archivo a `.env` en la carpeta desde
# donde corrés el servidor: se lee al arrancar y no pisa lo que ya esté definido en el entorno.
# Todo es opcional: sin `.env` el servidor escucha solo en esta máquina, en 127.0.0.1:3000.

# Dónde escucha. Detrás de un reverse proxy en la misma máquina, dejalo en 127.0.0.1.
HOST=127.0.0.1
PORT=3000

# Dirección pública, sin barra final. Es el issuer del OAuth, la base de los links de subida y el
# único host (además de localhost) que el servidor acepta en los headers Host y Origin.
# UTN_MCP_PUBLIC_URL=https://mcp.tu-dominio.com

# Quién puede conectarse por OAuth. Con UTN_MCP_ACCESS_URL decide un servicio tuyo: recibe
# POST { email, usuario, regional } con `Authorization: Bearer <UTN_MCP_ACCESS_SECRET>` y contesta
# { permitido, motivo?, url? }. Si no, UTN_MCP_ALLOWED_EMAILS: emails o dominios separados por coma.
# Sin ninguna de las dos, entra cualquiera con usuario de la UTN.
# UTN_MCP_ACCESS_URL=https://tu-dominio.com/acceso
# UTN_MCP_ACCESS_SECRET=
# UTN_MCP_ALLOWED_EMAILS=@frba.utn.edu.ar

# A dónde puede volver el login de OAuth sin aviso, además de loopback y los clientes conocidos
# (Claude, ChatGPT, VS Code, Cursor): hosts o esquemas terminados en ":", separados por coma. Otro
# host HTTPS se acepta solo si el usuario marca un aviso: con el registro abierto, cualquiera podría
# usar tu login para quedarse con la sesión de un alumno.
# UTN_MCP_REDIRECT_ALLOW=agente.tu-dominio.com,miapp:

# Habilita la API de /admin, con `Authorization: Bearer <UTN_MCP_ADMIN_SECRET>`, para un panel de
# cuentas propio:
# - POST /admin/usuarios: todos los usuarios, con su regional, apps conectadas y sesión del aula.
# - POST /admin/clientes ({ email }): lo mismo para un usuario; /admin/clientes/revocar ({ email,
#   cliente }) desconecta una app.
# - POST /admin/regionales: las regionales con su soporte (verificada, candidata, sin_soporte).
# - POST /admin/verificar ({ regional, usuario, contrasena }): entra al aula como el login de OAuth,
#   crea el usuario y le guarda la sesión; devuelve { usuario, nombre, email, primero? } (primero: fue
#   el primero en verificar la regional). Para dar de alta cuentas.
# UTN_MCP_ADMIN_SECRET=

# Página donde el usuario renueva su sesión del aula cuando vence; el agente se la pasa.
# Por defecto, el /login de este servidor.
# UTN_MCP_LOGIN_URL=https://mcp.tu-dominio.com/login

# Base de datos de sesiones. Por defecto, `utn-mcp.db` en la carpeta de config del usuario.
# UTN_MCP_DB=/var/lib/utn-mcp/utn-mcp.db

# Cada usuario elige su regional al iniciar sesión. UTN_REGIONAL es la que viene marcada por
# defecto (si no, frba) y la de quien usa UTN_USER/UTN_PASS sin `login`. También acepta los ids de
# las facultades de la UNC (unc-fcefyn, unc-derecho, unc-famaf...). Los ids están en
# src/aula-virtual/client/regionals.ts.
# UTN_REGIONAL=frt
# Si tu campus (UTN) o facultad (UNC) no está en la lista: la URL de su aula (y UTN_SSO_HOST si
# entra por SSO: el host del Keycloak, login.microsoftonline.com si es Office 365, o
# autenticar.unc.edu.ar si es una facultad de la UNC con el SAML2 central). Aparece como una
# opción más al iniciar sesión.
# UTN_AULA_BASE_URL=https://frt.cvg.utn.edu.ar
# UTN_SSO_HOST=auth.frt.utn.edu.ar

# Clave con que se cifran las sesiones: 32 bytes en base64 (`openssl rand -base64 32`). Sin ella se
# genera `store.key` al lado de la base. Hosteado, conviene inyectarla desde el gestor de secretos
# del proveedor y no escribirla acá: si queda en el mismo disco que la base, una copia lleva las dos.
# UTN_MCP_KEY=
